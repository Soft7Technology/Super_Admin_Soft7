# ==============================================================================
# Soft7 Super Admin - Environment Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Database (PostgreSQL Connection String for Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/super_admin_soft7?schema=public"

# Authentication & JWT Secrets
ACCESS_TOKEN_SECRET="your_access_token_secret"
REFRESH_TOKEN_SECRET="your_refresh_token_secret"

# Redis Configuration (OTP storage & verification)
REDIS_URL="redis://127.0.0.1:6379"

# SMTP Mail Server (OTPs, user registration emails, support ticket replies)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="support@example.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Soft7 Support <support@example.com>"
SMTP_REPLY_TO="support@example.com"

# Twilio Configuration (WhatsApp OTP delivery)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Cloudinary (Image/logo uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

# Support Ticket Ingestion Secret (Shared between WA_Dashboard and Super Admin)
SUPER_ADMIN_SUPPORT_TICKET_TOKEN="your_shared_ticket_ingest_token"

# External API & Custom Domains Routing
NEXT_PUBLIC_DOMAINS_API_BASE="/v1/admin"
